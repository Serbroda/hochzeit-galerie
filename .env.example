# Alle Einstellungen der Galerie mit ihren Vorgaben. Für Docker nach .env kopieren, docker compose liest sie
# von dort. Ohne Docker liest der Server .env.local und .env aus dem Arbeitsverzeichnis; echte
# Umgebungsvariablen gewinnen immer. Leere Werte bedeuten die Vorgabe.

# ── Nur docker compose ──────────────────────────────────────────────────────────────────────────────────────
# Port auf dem Host; im Container lauscht die Galerie immer auf 8080
GALERIE_PORT=8080

# ── Zugang ──────────────────────────────────────────────────────────────────────────────────────────────────
# Pflicht. Der geheime Teil der Adresse: https://…/photos/<PHOTOS_TOKEN>  (openssl rand -hex 24)
# Bleibt er gleich wie in der alten Java-Fassung, funktionieren alle verschickten Links weiter.
PHOTOS_TOKEN=
# Passwort für Galerie und ZIP-Download. Leer = Galerie offen und kein ZIP-Download.
# Bleiben Token und Passwort gleich, sind bereits freigeschaltete Browser weiter freigeschaltet.
# Link ohne Passworteingabe: /photos/<Token>?pass=<Passwort als Base64>, oder `galerie link <Basis-URL>`
PHOTOS_PASSWORD=
# Das Cookie wird bei HTTPS automatisch als Secure markiert, auch hinter einem Reverse Proxy
# (X-Forwarded-Proto). true erzwingt es.
SECURE_COOKIE=false

# ── Texte ───────────────────────────────────────────────────────────────────────────────────────────────────
COUPLE_NAME_1=Julia
COUPLE_NAME_2=Danny
GALLERY_SUBTITLE=Die schönsten Momente unserer Hochzeit
ZIP_NAME=Hochzeitsfotos.zip

# ── Verzeichnisse (im Container: DATA_DIR=/data) ─────────────────────────────────────────────────────────────
# Aufgebaut wie das Datenverzeichnis der alten Java-Fassung, das sich deshalb einfach herüberkopieren lässt:
#   data/wedding.db                          Reihenfolge, Originalnamen, "Foto von" - wird nur gelesen
#   data/assets/photos/<PHOTOS_TOKEN>/       die Fotos; was hier liegt, zeigt die Galerie
#   data/assets/photos/<PHOTOS_TOKEN>/thumbs/, large/   verkleinerte Fassungen, entstehen bei Bedarf
# Ohne wedding.db wird nach Dateinamen sortiert (foto-2 vor foto-10); Fotos, die nicht in der Datenbank
# stehen, folgen nach den übrigen. Neue Dateien erscheinen nach spätestens einer Minute.
#DATA_DIR=data
# Einzeln abweichend, falls nötig:
#PHOTOS_DIR=data/assets/photos/<PHOTOS_TOKEN>
#CACHE_DIR=<PHOTOS_DIR>
# off schaltet das Lesen der alten Datenbank ab
#LEGACY_DB=data/wedding.db

# ── Betrieb ─────────────────────────────────────────────────────────────────────────────────────────────────
# Wie viele Fotos gleichzeitig verkleinert werden; jedes braucht beim Dekodieren rund 70 MB.
# Vorgabe: 2 (oder weniger bei nur einem Kern)
IMAGE_WORKERS=
# debug, info, warn oder error. Auf debug erscheint auch jeder Abruf eines Fotos.
LOG_LEVEL=info
# Nur ohne Docker: Adresse, auf der der Server lauscht
#ADDR=:8080
